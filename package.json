{
  "name": "foolon-admin-monorepo",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "docker:compose:deploy": "cd ./api && pnpm run build && cd ../web && pnpm run build && cd ../ && docker compose up -d --build",
    "prepare": "husky install",
    "dev": "pnpm run --parallel -r dev",
    "build": "pnpm -r run build",
    "format": "prettier --write \"**/*.{vue,js,ts,jsx,tsx,json,md,html,css,scss}\"",
    "lint": "eslint . --fix",
    "gen:types": "pnpm --filter web run openapi-typescript && pnpm run format"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "husky": "^8.0.3",
    "lodash": "^4.17.21",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@rushstack/eslint-patch": "^1.3.3",
    "@types/lodash": "^4.17.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-vue": "^9.17.0",
    "lint-staged": "^15.2.7",
    "prettier": "^3.2.5",
    "typescript": "5.4.5"
  },
  "lint-staged": {
    "**/*.{js,ts,vue,jsx,tsx}": "eslint --fix",
    "**/*.{vue,js,ts,jsx,tsx,json,md,html,css,scss}": "prettier --write"
  }
}
